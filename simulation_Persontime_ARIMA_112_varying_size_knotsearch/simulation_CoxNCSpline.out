> # simulate for NCSpline with knot = 10, varying sample size and degree
> temp <- data.frame()
> 
> for (sample_size in c(300, 500, 1000, 3000, 5000)){
+   for (degree in c(3, 4, 5)) {
+     result <- simulation_output(sample_size = sample_size, knot = 10, degree = degree, method = "NCSpline")
+     result$sample_size <- sample_size
+     result$degree <- degree
+     cat(sprintf("sample_size = %d, degree = %d: average number of events = %.1f\n",
+                 sample_size, degree, mean(result$n_events, na.rm = TRUE)))
+     temp <- rbind(temp, result)
+   }
+ }
