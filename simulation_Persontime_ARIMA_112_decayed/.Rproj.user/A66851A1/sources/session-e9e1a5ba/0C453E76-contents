library(tidyverse)

# read simulation results

# polynomials
result_poly <- readRDS("simulation_Polynomial.rds")

result_poly <- result_poly %>% group_by(knot, degree, l) %>%
  summarise(log_HR_true = mean(log_HR_true),
            log_HR_estimate_mean = mean(log_HR_estimate),
            log_HR_estimate_se = sd(log_HR_estimate))

result_poly$method <- "Polynomial"

# natural cubic splines
result_NCS <- readRDS("simulation_NCSpline.rds")
result_NCS <- result_NCS %>% group_by(knot, degree, l) %>%
  summarise(log_HR_true = mean(log_HR_true),
            log_HR_estimate_mean = mean(log_HR_estimate),
            log_HR_estimate_se = sd(log_HR_estimate))
result_NCS$method <- "Natural Cubic Splines"



# combine all the results together

temp <- bind_rows(result_poly, result_NCS)

temp$knot <- paste("Knot:", temp$knot)
temp$degree <- paste("Degree:", temp$degree)

temp$knot <- factor(temp$knot,
                    levels = c("Knot: 5", "Knot: 10", "Knot: 15"))

ggplot(temp) + 
  geom_line(aes(x = l, y = log_HR_estimate_mean, color = method)) + 
  geom_line(aes(x = l, y = log_HR_true), color = "black", linetype = "dashed") + 
  facet_grid(degree~knot, labeller = label_parsed) + 
  geom_ribbon(aes(x = l, ymin = log_HR_estimate_mean-1.96*log_HR_estimate_se, ymax =log_HR_estimate_mean+1.96*log_HR_estimate_se, 
                  fill = method), alpha = 0.2) 

