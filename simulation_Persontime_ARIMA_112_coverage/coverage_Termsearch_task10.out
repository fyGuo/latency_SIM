> 
> library(future)
> library(furrr)
> library(LatencyA)
> 
> # ── Method, scenario, part selection ──────────────────────────────────────────
> method <- Sys.getenv("METHOD", "Knotsearch")
> stopifnot(method %in% c("Knotsearch", "Termsearch"))
> 
> scenarios     <- names(WEIGHT_CURVES)    # 6 shapes, fixed order from weight_curves.R
> n_parts       <- 6
> sims_per_part <- 50
> 
> task <- Sys.getenv("SLURM_ARRAY_TASK_ID", "")
> if (nzchar(task)) {                       # cluster: array index 1..(n_scen*n_parts)
+   idx <- as.integer(task)
+   stopifnot(idx >= 1, idx <= length(scenarios) * n_parts)
+   scen_i <- (idx - 1L) %/% n_parts + 1L
+   part   <- (idx - 1L) %%  n_parts + 1L
+ } else {                                  # local: SCENARIO + PART env vars
+   scenario <- Sys.getenv("SCENARIO", scenarios[1])
+   scen_i   <- match(scenario, scenarios)
+   part     <- as.integer(Sys.getenv("PART", "1"))
+   stopifnot(!is.na(scen_i), part >= 1, part <= n_parts)
+ }
> scenario <- scenarios[scen_i]
> method_i <- match(method, c("Knotsearch", "Termsearch"))
> 
> # Distinct RNG stream per (method, scenario, part).
> set.seed(10000L * method_i + 1000L * scen_i + part)
> 
> # 95% bootstrap-percentile coverage at lags 1, 8, 15 under the true weighting
> # curve `scenario` (n = 5000, gamma = 0.1, lambda_0 = 0.5, true latency = 16).
> result <- coverage_output(method      = method,
+                           weights     = WEIGHT_CURVES[[scenario]],
+                           scenario    = scenario,
+                           sample_size = 5000,
+                           gamma       = 0.1,
+                           lambda_0    = 0.5,
+                           intercept   = 0,
+                           lags        = c(1, 8, 15),
+                           n_sims      = sims_per_part,
+                           boot_iter   = 300,
+                           parallel    = TRUE)
[Termsearch/bimodal_pos] finished 10 / 50 replicates
[Termsearch/bimodal_pos] finished 20 / 50 replicates
[Termsearch/bimodal_pos] finished 30 / 50 replicates
[Termsearch/bimodal_pos] finished 40 / 50 replicates
[Termsearch/bimodal_pos] finished 50 / 50 replicates
> 
> # Make sim_id unique across parts (part 1 -> 1:50, part 2 -> 51:100, ...).
> result$sim_id <- result$sim_id + (part - 1L) * sims_per_part
> 
> saveRDS(result, sprintf("coverage_%s_%s_part%d.rds", method, scenario, part))
> 
> cat(sprintf("== %s / %s part %d / %d: 95%% percentile-interval coverage by lag ==\n",
+             method, scenario, part, n_parts))
== Termsearch / bimodal_pos part 4 / 6: 95% percentile-interval coverage by lag ==
