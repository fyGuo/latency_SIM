> 
> library(future)
> library(furrr)
> library(LatencyA)
> 
> # ── Part selection ─────────────────────────────────────────────────────────────
> # The 300 replicates are split into 5 independent jobs of 60 sims each, so a
> # crashed job only loses its own part. Submit with `sbatch --array=1-5`, or set
> # PART=k manually; defaults to part 1.
> part          <- as.integer(Sys.getenv("SLURM_ARRAY_TASK_ID",
+                                        Sys.getenv("PART", "1")))
> n_parts       <- 5
> sims_per_part <- 60
> stopifnot(part >= 1, part <= n_parts)
> 
> # 95% bootstrap-percentile coverage of Term-search at lag 8
> # (n = 5000, knot = 10, gamma = 0.1).
> set.seed(200 + part)   # distinct seed per part (and per method)
> result <- coverage_output(method      = "Termsearch",
+                           sample_size = 5000,
+                           knot        = 10,
+                           gamma       = 0.1,
+                           lags        = 8,
+                           n_sims      = sims_per_part,
+                           boot_iter   = 300)
[Termsearch] finished 10 / 60 replicates
[Termsearch] finished 20 / 60 replicates
[Termsearch] finished 30 / 60 replicates
[Termsearch] finished 40 / 60 replicates
[Termsearch] finished 50 / 60 replicates
[Termsearch] finished 60 / 60 replicates
> 
> # Make sim_id unique across parts (part 1 -> 1:60, part 2 -> 61:120, ...)
> result$sim_id <- result$sim_id + (part - 1L) * sims_per_part
> 
> saveRDS(result, sprintf("coverage_Termsearch_part%d.rds", part))
> 
> cat(sprintf("== Term-search part %d / %d: 95%% percentile-interval coverage ==\n",
+             part, n_parts))
